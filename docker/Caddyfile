# Caddy: HTTPS with automatic Let’s Encrypt.
#
# Two names in one block = one certificate for BOTH (new “identifier set” vs aytingchi.uz alone;
# use this if production LE rate-limits repeated single-name issuances).
#
# DNS required before first HTTPS works:
#   - A/AAAA: aytingchi.uz -> server IP
#   - A/AAAA: www.aytingchi.uz -> same IP  OR  CNAME: www -> aytingchi.uz
#
# Service DNS on compose network: backend, frontend

aytingchi.uz, www.aytingchi.uz {
	encode zstd gzip

	@api {
		path /health
		path /stt
		path /llm
		path /tts
		path /voice_reply
		path /operator-advice
		path /docs
		path /docs/*
		path /redoc
		path /redoc*
		path /openapi.json
		path /client-analytics*
		path /voices
		path /ws*
	}

	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
