# Caddy: HTTPS (www) + HTTP redirect (apex) without a second cert for the apex.
#
# If Let's Encrypt was rate-limited for aytingchi.uz alone, www.aytingchi.uz can
# still get its own cert. The app is served on www; apex uses HTTP to redirect
# to www (no TLS needed for that hop).
#
# DNS: A/AAAA for aytingchi.uz and for www.aytingchi.uz (or CNAME www -> @).
# After the LE 168h limit expires for the apex, you can merge into one line:
#   aytingchi.uz, www.aytingchi.uz {  ...  }
# and set PUBLIC_ORIGIN to https://aytingchi.uz again if you prefer.

# Only HTTP: sends users to the working HTTPS name (no cert for apex in this block).
http://aytingchi.uz {
	redir https://www.aytingchi.uz{uri} permanent
}

# Main site (LE issued cert for this name successfully in your latest logs)
www.aytingchi.uz {
	encode zstd gzip

	@api {
		path /health
		path /stt
		path /llm
		path /tts
		path /voice_reply
		path /operator-advice
		path /docs
		path /docs/*
		path /redoc
		path /redoc*
		path /openapi.json
		path /client-analytics*
		path /voices
		path /ws*
	}

	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
