# Caddy: public HTTP on :80. Routes FastAPI by path, everything else to Next.
# For automatic HTTPS, replace the first line with your domain, e.g.  aytingchi.uz  {  (same block body).
# Service DNS: backend, frontend (compose network).

:80 {
	encode zstd gzip

	@api {
		path /health
		path /stt
		path /llm
		path /tts
		path /voice_reply
		path /operator-advice
		path /docs
		path /docs/*
		path /redoc
		path /redoc*
		path /openapi.json
		path /client-analytics*
		path /voices
		path /ws*
	}

	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
