# Root .env for: docker compose build / up  (copy to .env next to docker-compose.yml)
#
# --- Next.js build (what users type in the address bar; no :3000 / :8000) ---
# If you use plain HTTP (docker/Caddyfile line 1 is :80), use http and ws. For a domain
# with HTTPS, set docker/Caddyfile site name(s) (e.g. aytingchi.uz, www.aytingchi.uz) and
# add matching DNS, then:
PUBLIC_ORIGIN=https://aytingchi.uz
WS_URL=wss://aytingchi.uz/ws/voice
# www works too if Caddyfile lists it and DNS has www (same wss host as PUBLIC_ORIGIN)
#
# HTTP / IP (default Caddyfile :80) example:
# PUBLIC_ORIGIN=http://46.225.79.113
# WS_URL=ws://46.225.79.113/ws/voice
#
# Optional: if backend uses API_SHARED_SECRET, set the same for client tools
# NEXT_PUBLIC_WS_API_KEY=
