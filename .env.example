# Root .env for: docker compose build / up  (copy to .env next to docker-compose.yml)
#
# --- Caddy: first line of docker/Caddyfile ---
#   aytingchi.uz     → automatic HTTPS (needs DNS pointing here)
#   :80              → HTTP only on port 80 (OK for a public IP: http://x.x.x.x)
CADDY_SITE=aytingchi.uz

# --- Next.js build (must match what users type in the address bar; no :3000 / :8000) ---
# Use https + wss when CADDY_SITE is a real domain; use http + ws with CADDY_SITE=:80
PUBLIC_ORIGIN=https://aytingchi.uz
WS_URL=wss://aytingchi.uz/ws/voice

# Examples (IP / HTTP-only):
# CADDY_SITE=:80
# PUBLIC_ORIGIN=http://46.225.79.113
# WS_URL=ws://46.225.79.113/ws/voice

# Optional: if backend uses API_SHARED_SECRET, set the same value for client tools
# NEXT_PUBLIC_WS_API_KEY=
