FRONTEND_ORIGIN=http://localhost:3000

# Hugging Face (optional; gated models and higher rate limits)
HF_TOKEN=

# STT (faster-whisper) — defaults favor Uzbek accuracy; use base + STT_BEAM_SIZE=1 for max speed
# Accepts three forms:
#   1. Official whisper size: tiny | base | small | medium | large-v3 | distil-large-v3 | …
#   2. A local CT2 directory (absolute or relative to backend/).
#   3. A Hugging Face repo id (contains "/") — auto-downloaded + converted to CT2
#      on first use and cached under STT_MODEL_CACHE_DIR. Use this for Uzbek-specific
#      fine-tunes that beat vanilla Whisper on Uzbek, e.g.:
#        STT_MODEL_SIZE=islomov/rubaistt_v2_medium     # ~17% WER, Tashkent dialect
#        STT_MODEL_SIZE=akbaralihah/uzbek-stt          # ~16.7% WER, 1.6k h dataset
#        STT_MODEL_SIZE=OvozifyLabs/whisper-small-uz-v1  # UZ + EN + RU mixed
STT_MODEL_SIZE=small
STT_MODEL_CACHE_DIR=models/whisper_ct2
# float16 on GPU, int8_float16 on CPU, int8 for smallest footprint
STT_CT2_QUANTIZATION=float16
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
STT_LANGUAGE=uz
# Beam 6–8 for clearer Uzbek on GPU; 4 on slow CPU; 1 = greedy
STT_BEAM_SIZE=7
# Tighter catches repetitive hallucinations; raise to 2.4 if real speech is cut
STT_COMPRESSION_RATIO_THRESHOLD=2.2
# false = less loop garbage on short phrases; true = longer dictation continuity
STT_CONDITION_ON_PREVIOUS_TEXT=false
# Optional: override built-in Uzbek bias string (empty = use code default)
# STT_HOTWORDS=
# STT_PATIENCE=1.15
# STT_REPETITION_PENALTY=1.08
# STT_NO_REPEAT_NGRAM_SIZE=3
STT_BEST_OF=1
STT_WITHOUT_TIMESTAMPS=true
# Override to "" to disable. Default in code biases Uzbek Latin (o‘, g‘, sh, ch, …)
# STT_INITIAL_PROMPT=
STT_VAD_FILTER=true
# Optional Silero VAD overrides (single-line JSON object)
# STT_VAD_PARAMETERS_JSON={"min_silence_duration_ms":600}
# Optional faster-whisper decode overrides (omit vars = library defaults)
# STT_TEMPERATURE=0
# STT_COMPRESSION_RATIO_THRESHOLD=2.4
# STT_LOG_PROB_THRESHOLD=-1.0
STT_CONDITION_ON_PREVIOUS_TEXT=true
MAX_AUDIO_SECONDS=60

# TTS backend selection.
#   omnivoice = local flow-matching voice-clone (5+ GB weights, 10–80 s on a laptop GPU)
#   edge      = Microsoft neural TTS, real-time (~1 s), native Uzbek voices, FREE, no GPU
# For real-time chat on a laptop use edge. For maximum cloning fidelity use omnivoice.
TTS_BACKEND=omnivoice
# Edge voice (only used when TTS_BACKEND=edge).
# Options: uz-UZ-MadinaNeural (female), uz-UZ-SardorNeural (male).
TTS_EDGE_VOICE=uz-UZ-MadinaNeural

# TTS (OmniVoice)
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
# CPU: TTS_DEVICE_MAP=cpu TTS_DTYPE=float32
# NVIDIA GPU: install torch+cu126 (see requirements.txt note), then TTS_DEVICE_MAP=cuda:0 TTS_DTYPE=float16
TTS_DEVICE_MAP=cpu
TTS_DTYPE=float32
# OmniVoice is a diffusion/flow-matching model — synthesis time is LINEAR in TTS_NUM_STEPS.
# 6–8 = chat-grade (fast), 10–14 = audiobook-grade, 16+ rarely worthwhile.
# Going 16 -> 8 ≈ 2× faster with near-imperceptible quality loss on short replies.
TTS_NUM_STEPS=8
TTS_SPEED=1.05
# Sentence-level streaming on /ws/voice: synthesize + send one segment at a time,
# so the user hears the first sentence while the rest is still rendering.
TTS_STREAM_SEGMENTS=true
TTS_STREAM_MIN_CHARS=40
TTS_STREAM_MAX_CHARS=220
# Warm OmniVoice's lazy internal Whisper on startup (saves ~20–30 s on first TTS call).
TTS_WARMUP_ON_START=true
TTS_WARMUP_TEXT=Salom.
# Optional style hint (Uzbek Latin). Clear with TTS_INSTRUCT= to disable.
# TTS_INSTRUCT=
# Voice clone: path to your WAV (repo root, backend cwd, or absolute). Quote if spaces.
# Example: TTS_REF_AUDIO_PATH=myVoice/reference.wav
TTS_REF_AUDIO_PATH=
# Exact words spoken in that clip (strongly recommended for clone quality)
TTS_REF_TEXT=
# Folder under repo root scanned at startup for extra clone voices (GET /voices)
TTS_VOICES_SCAN_DIR=myVoice
TTS_PCM_CHUNK_MS=32

# LLM: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Max new tokens from Ollama (0 = unlimited). Lower = faster replies for voice.
OLLAMA_NUM_PREDICT=256
LLM_TIMEOUT_SECONDS=120
# OpenAI only; 0 = no cap
OPENAI_MAX_TOKENS=256
# Prior user+assistant turns kept per /ws/voice connection (not counting current user message)
LLM_HISTORY_MAX_MESSAGES=24
# Optional: when set, require ?token= on WebSocket and X-API-Key or Bearer on REST
API_SHARED_SECRET=
